<style>
/* Layout: nav fixa translúcida, hero com foto, sobre em 2 colunas, qualificações 2x2, áreas 3 colunas, frase em faixa, contato em 2 colunas */
:root {
  --bg: #f9f8f6;
  --bg-alt: #ede8e1;
  --card: #f3ede8;
  --line: #e8e1da;
  --ink: #1a1f2e;
  --muted: #6b7385;
  --blue: #5f7fa6;
  --gold: #c4994f;
  --gold-soft: #e9d9bd;
  --serif: "Cormorant Garamond", Georgia, "Times New Roman", serif;
  --sans: "Raleway", "Helvetica Neue", Arial, sans-serif;
  --gutter: clamp(16px, 5.5vw, 106px);
  color-scheme: light;
}
* { box-sizing: border-box; }
html { scroll-behavior: smooth; }
body {
  background: var(--bg);
  color: var(--ink);
  font-family: var(--sans);
  font-weight: 300;
  line-height: 1.6;
  padding-left: max(0px, env(safe-area-inset-left, 0px));
  padding-right: max(0px, env(safe-area-inset-right, 0px));
}
body::before { content: ""; position: fixed; inset: 0 0 auto; height: env(safe-area-inset-top, 0px); z-index: 60; background: rgba(249,248,246,.92); }
a { color: inherit; text-decoration: none; }
h1, h2, h3 { font-family: var(--serif); font-weight: 500; margin: 0; text-wrap: balance; }
p { margin: 0; }
section[id] { scroll-margin-top: 80px; }

.wrap { width: 100%; margin-inline: auto; padding-inline: max(16px, env(safe-area-inset-left, 0px)) max(16px, env(safe-area-inset-right, 0px)); }
.eyebrow { font-size: 1.05rem; letter-spacing: .3em; text-transform: uppercase; color: var(--gold); font-weight: 400; }
.sec-head { text-align: center; display: grid; gap: 14px; justify-items: center; }
.sec-head h2 { font-size: clamp(2.6rem, 4.4vw, 3.6rem); }

/* NAV */
.nav { position: fixed; top: env(safe-area-inset-top, 0px); left: 0; right: 0; z-index: 50; height: 80px; background: rgba(249,248,246,.9); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); border-bottom: 1px solid var(--line); }
.nav .in { height: 100%; display: flex; align-items: center; justify-content: space-between; padding-inline: max(var(--gutter), env(safe-area-inset-left, 0px)) max(var(--gutter), env(safe-area-inset-right, 0px)); }
.logo { font-family: var(--serif); font-weight: 600; font-size: 1.75rem; letter-spacing: .02em; }
.nav ul { display: flex; gap: clamp(16px, 2.6vw, 40px); list-style: none; margin: 0; padding: 0; }
.nav ul a { font-size: .95rem; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); font-weight: 400; transition: color .25s; padding: 6px 0; }
.nav ul a:hover { color: var(--gold); }
.nav ul a:focus-visible, .btn:focus-visible { outline: 2px solid var(--gold); outline-offset: 4px; }

/* HERO */
.hero { position: relative; min-height: max(100vh, 760px); display: flex; align-items: center; justify-content: center; text-align: center; padding: 140px 0 120px; background: linear-gradient(to bottom, rgba(44,52,70,.8) 0%, rgba(44,52,70,.72) 55%, var(--bg) 100%), #4b5363 url("img/foto-hero.jpg") 50% 28% / cover no-repeat; }
.hero .box { position: relative; z-index: 1; max-width: 860px; margin-inline: auto; text-align: center; display: grid; justify-items: center; gap: 18px; }
.hero .kicker { color: #fff; letter-spacing: .4em; text-transform: uppercase; font-size: 1.15rem; font-weight: 300; }
.hero h1 { color: #fff; font-size: clamp(3.6rem, 8vw, 6.4rem); line-height: 1.05; letter-spacing: .01em; }
.hero .rule { width: 120px; height: 1px; background: var(--gold); margin: 14px 0 10px; }
.hero p { color: #fff; font-size: clamp(1.15rem, 1.8vw, 1.6rem); max-width: 830px; line-height: 1.55; }
.btn { display: inline-flex; align-items: center; gap: 10px; padding: 18px 40px; font-family: var(--sans); font-weight: 400; font-size: 1rem; letter-spacing: .1em; text-transform: uppercase; border-radius: 2px; border: 1px solid var(--gold); transition: background .25s, color .25s, transform .25s, box-shadow .25s; }
.btn-gold { background: var(--gold); color: #fff; box-shadow: 0 4px 14px rgba(196,153,79,.25); }
.btn-gold:hover { background: #b58840; transform: translateY(-2px); }
.btn-line { background: transparent; color: var(--ink); border-color: #cfc8bf; }
.btn-line:hover { border-color: var(--gold); color: var(--gold); transform: translateY(-2px); }
.hero .btn { margin-top: 24px; }
.btn svg { width: 18px; height: 18px; flex: none; }

/* SOBRE */
.sobre { padding-block: 110px; }
.sobre .grid { max-width: 1280px; margin-inline: auto; display: grid; grid-template-columns: 590px 1fr; gap: 100px; align-items: center; }
.sobre figure { margin: 0; }
.sobre img { width: 100%; aspect-ratio: 936 / 1280; object-fit: cover; object-position: 50% 12%; border-radius: 2px; display: block; }
.sobre .txt { display: grid; gap: 22px; min-width: 0; }
.sobre h2 { font-size: clamp(2.8rem, 4.6vw, 3.7rem); line-height: 1.1; margin-bottom: 14px; }
.sobre p { font-size: 1.22rem; line-height: 1.65; color: var(--muted); }
.sobre p strong { color: var(--ink); font-weight: 500; }
.handle { display: flex; align-items: center; gap: 20px; margin-top: 18px; color: var(--gold); letter-spacing: .12em; text-transform: uppercase; font-size: 1.1rem; font-weight: 400; }
.handle::before { content: ""; width: 60px; height: 1px; background: var(--gold); flex: none; }

/* QUALIFICAÇÕES */
.qual { position: relative; overflow: hidden; padding-block: 90px 110px; }
.qual::before { content: ""; position: absolute; top: -90px; left: -90px; width: 220px; height: 220px; border-radius: 50%; background: #f3efe8; }
.qual::after { content: ""; position: absolute; right: -150px; bottom: -150px; width: 400px; height: 400px; border-radius: 50%; background: #f3efe8; }
.qual .wrap > * { position: relative; z-index: 1; }
.qual .sub { color: var(--blue); font-size: 1.2rem; max-width: 620px; line-height: 1.55; }
.qual .cards { max-width: 1120px; margin: 80px auto 0; display: grid; grid-template-columns: 1fr 1fr; gap: 30px; }
.qcard { background: var(--card); border: 1px solid var(--line); border-radius: 2px; padding: 40px; display: flex; gap: 25px; align-items: flex-start; transition: transform .3s, box-shadow .3s; }
.qcard:hover { transform: translateY(-3px); box-shadow: 0 14px 30px rgba(26,31,46,.06); }
.qcard h3 { font-size: 1.5rem; font-weight: 600; line-height: 1.25; margin-bottom: 8px; }
.qcard p { color: var(--muted); font-size: 1.1rem; line-height: 1.45; }
.qcard > div { min-width: 0; }
.ico { flex: none; width: 60px; height: 60px; border-radius: 50%; border: 1px solid var(--gold-soft); display: grid; place-items: center; color: var(--gold); background: rgba(249,248,246,.4); }
.ico svg { width: 26px; height: 26px; }

/* ÁREAS */
.areas { background: var(--bg-alt); padding-block: 110px 120px; }
.areas .cards { max-width: 1280px; margin: 80px auto 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 40px; }
.acard { background: var(--bg); border-radius: 2px; padding: 50px 40px; text-align: center; display: grid; justify-items: center; gap: 22px; align-content: start; transition: transform .3s, box-shadow .3s; }
.acard:hover { transform: translateY(-4px); box-shadow: 0 18px 36px rgba(26,31,46,.08); }
.acard .ico { width: 70px; height: 70px; }
.acard .ico svg { width: 28px; height: 28px; }
.acard h3 { font-size: 1.7rem; font-weight: 600; }
.acard p { color: var(--muted); font-size: 1.1rem; line-height: 1.55; }

/* FRASE */
.quote { position: relative; min-height: 590px; display: grid; place-items: center; text-align: center; background: linear-gradient(rgba(44,52,70,.76), rgba(44,52,70,.76)), #4b5363 url("img/foto-selfie.jpg") 50% 32% / cover no-repeat; padding-block: 90px; }
.quote .box { display: grid; justify-items: center; gap: 28px; max-width: 760px; margin-inline: auto; }
.quote .rule { width: 60px; height: 1px; background: var(--gold); }
.quote blockquote { margin: 0; font-family: var(--serif); font-style: italic; font-weight: 300; color: #fff; font-size: clamp(2.2rem, 4vw, 3.4rem); line-height: 1.25; text-wrap: balance; }
.quote cite { font-style: normal; color: var(--gold-soft); letter-spacing: .25em; text-transform: uppercase; font-size: 1rem; }

/* CONTATO */
.contato { padding-block: 120px; }
.contato .grid { max-width: 1250px; margin-inline: auto; display: grid; grid-template-columns: 470px 1fr; gap: clamp(40px, 10vw, 206px); align-items: center; }
.duo { position: relative; width: 100%; max-width: 470px; padding-bottom: 12%; }
.duo img { display: block; object-fit: cover; border-radius: 2px; }
.duo .a { width: 80%; aspect-ratio: 2 / 3; object-position: 50% 10%; }
.duo .b { position: absolute; right: 0; bottom: 0; width: 52%; aspect-ratio: 3 / 4; object-position: 50% 12%; border: 8px solid var(--bg); box-shadow: 0 16px 36px rgba(26,31,46,.14); }
.contato .txt { display: grid; gap: 18px; justify-items: start; min-width: 0; max-width: 560px; }
.contato h2 { font-size: clamp(2.6rem, 4.2vw, 3.4rem); }
.contato p { color: var(--muted); font-size: 1.15rem; line-height: 1.65; }
.contato .btns { display: flex; flex-wrap: wrap; gap: 16px; margin-top: 22px; }
.contato .btn { padding: 16px 34px; font-size: .95rem; }

.foot { border-top: 1px solid var(--line); padding-block: 36px; text-align: center; color: var(--muted); font-size: .9rem; letter-spacing: .08em; }

@media (max-width: 1100px) {
  .sobre .grid { grid-template-columns: 1fr; gap: 48px; max-width: 640px; }
  .contato .grid { grid-template-columns: 1fr; gap: 48px; max-width: 560px; }
  .areas .cards { grid-template-columns: 1fr; max-width: 520px; gap: 24px; }
}
@media (max-width: 760px) {
  .nav { height: 64px; }
  .logo { font-size: 1.4rem; }
  .nav ul { gap: 14px; }
  .nav ul a { font-size: .72rem; letter-spacing: .06em; }
  .nav ul li:first-child { display: none; }
  .hero { padding: 110px 0 100px; min-height: 640px; background-position: 50% 30%; }
  .qual .cards { grid-template-columns: 1fr; margin-top: 48px; }
  .qcard { padding: 28px 24px; gap: 18px; }
  .sobre, .areas, .contato { padding-block: 72px; }
  .qual { padding-block: 72px; }
  .areas .cards { margin-top: 48px; }
  .quote { min-height: 460px; }
  .btn { padding: 16px 26px; }
}
@media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } * { transition: none !important; } }
</style>
</head>
